{
  "model": {
    "vocab_size": 2831,
    "max_seq_len": 512,
    "d_model": 320,
    "n_layers": 6,
    "n_heads": 8,
    "ffn_hidden": 800,
    "dropout": 0.1,
    "pad_id": 0,
    "bos_id": 1,
    "eos_id": 2
  },
  "train": {
    "batch_size": 32,
    "learning_rate": 0.0002,
    "min_lr": 2e-05,
    "warmup_steps": 800,
    "max_steps": 30000,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "eval_interval": 200,
    "save_interval": 1000,
    "device": "auto",
    "seed": 42,
    "data_dir": "data",
    "output_dir": "checkpoints"
  }
}